#!/bin/sh

# Prefer Russian LuCI when the Russian catalog is present.
uci -q set luci.main.lang='ru'
uci -q commit luci

# The 3-port LAN bridge itself is generated by the patched sunxi 02_network.
# Modem interfaces are intentionally left to luci-app-5gmodem: the application
# identifies each modem by stable USB topology, which also supports mixed modem
# types (EC25/EC200A/SLM750) without assuming fixed cdc-wdm numbering.

/etc/init.d/mcr102-modems enable 2>/dev/null || true

logger -t mcr102 "OpenWrt 25.12.5 MCR-102 defaults applied"
exit 0
